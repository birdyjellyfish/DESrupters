# Required external API credentials; fill these in your private .env.
LTA_ACCOUNT_KEY=
ONEMAP_KEY=
NEXT_PUBLIC_MAP_STYLE_URL=
# Local services; npm run setup fills portable localhost URLs.
DATABASE_URL=
POSTGRES_PASSWORD=
REDIS_URL=
VALHALLA_URL=
# Optional public deployment and Web Push settings.
PUBLIC_APP_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional alternative Next.js build directory.
NEXT_DIST_DIR=
# Optional combined Cloud Run container settings.
RUN_COMMUTE_MONITOR=
VALHALLA_THREADS=
